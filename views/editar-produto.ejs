<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Editar Produto — SSR Relacional</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f8f9fa; display: flex; justify-content: center; padding-top: 40px; }
        .form-card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); width: 420px; }
        h2 { margin-top: 0; color: #333; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; color: #555; }
        input, select { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
        .btn-group { margin-top: 20px; display: flex; justify-content: space-between; }
        button { padding: 10px 15px; background: #17a2b8; color: white; border: none; border-radius: 4px; cursor: pointer; }
        .btn-cancel { padding: 10px 15px; background: #6c757d; color: white; text-decoration: none; border-radius: 4px; font-size: 14px; }
    </style>
</head>
<body>
    <div class="form-card">
        <h2>Editar Produto</h2>
        <form action="/produtos/editar/<%= produto.id %>" method="POST">
            <div class="form-group">
                <label>Nome do Produto:</label>
                <input type="text" name="nome_produto" value="<%= produto.nome_produto %>" required>
            </div>

            <!-- SELETOR COM PRÉ-SELEÇÃO DA CHAVE ESTRANGEIRA -->
            <div class="form-group">
                <label>Grupo / Categoria:</label>
                <select name="grupo_id" required>
                    <option value="">-- Selecione um Grupo --</option>
                    <!-- BLOCO EJS: Compara grupo.id com produto.grupo_id para injetar o atributo 'selected' no item correto -->
                    <% grupos.forEach(grupo => { %>
                        <option value="<%= grupo.id %>" <%= grupo.id === produto.grupo_id ? 'selected' : '' %>>
                            <%= grupo.descricao_grupo %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label>Peso (kg):</label>
                <input type="number" step="0.01" name="peso" value="<%= produto.peso %>" required>
            </div>

            <div class="form-group">
                <label>Preço (R$):</label>
                <input type="number" step="0.01" name="preco" value="<%= produto.preco %>" required>
            </div>

            <div class="btn-group">
                <a href="/produtos" class="btn-cancel">Cancelar</a>
                <button type="submit">Atualizar Produto</button>
            </div>
        </form>
    </div>
</body>
</html>